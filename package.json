{
  "name": "radioplayer",
  "version": "1.1.1",
  "description": "Lokalni player za internetski radio i WebSDR prijemnike",
  "author": "Jasmin",
  "homepage": "https://github.com/rjasmin-alg/radioplayer",
  "main": "desktop/main.js",
  "desktopName": "radioplayer.desktop",
  "private": true,
  "scripts": {
    "start": "node server.js --open",
    "desktop": "electron .",
    "icon": "electron desktop/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "hr.radioplayer.app",
    "productName": "RadioPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "public/**",
      "desktop/main.js",
      "desktop/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/icon.png"
    },
    "portable": {
      "artifactName": "RadioPlayer-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "RadioPlayer-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "RadioPlayer"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "desktop/icon.png",
      "category": "AudioVideo",
      "executableName": "radioplayer",
      "syncDesktopName": true,
      "maintainer": "Jasmin",
      "synopsis": "Player za internetski radio i WebSDR prijemnike",
      "artifactName": "RadioPlayer-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "RadioPlayer",
          "Keywords": "radio;stream;sdr;websdr;kiwisdr;"
        }
      }
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  }
}
